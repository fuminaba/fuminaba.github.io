---
// src/pages/wiki.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const wikiItems = await getCollection('wiki');
const sortedWiki = wikiItems.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group wiki articles by series if specified, otherwise put in "General Reference"
const groupedWiki = sortedWiki.reduce((groups, item) => {
    const series = item.data.series || "General Reference";
    if (!groups[series]) {
        groups[series] = [];
    }
    groups[series].push(item);
    return groups;
}, {} as Record<string, typeof sortedWiki>);

const formatDate = (date: Date) => {
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
    });
};
---

<Layout title="Wiki" description="Fumiya Inaba's personal knowledge base, notes on machine learning, coding environments, and digital oncology.">
    <div style="margin-bottom: 2rem;">
        <h1 style="margin-bottom: 0.5rem;">Wiki & Research Notes</h1>
        <p style="color: var(--text-muted); margin-bottom: 3rem;">
            A personal wiki containing research notes, coding setups, ML guidelines, and reference materials.
        </p>

        <div style="display: flex; flex-direction: column; gap: 3rem;">
            {Object.keys(groupedWiki).length === 0 ? (
                <div class="card" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                    No wiki articles found. Check back soon!
                </div>
            ) : (
                Object.entries(groupedWiki).map(([series, items]) => (
                    <div>
                        <!-- Series header -->
                        <h2 style="font-size: 1.4rem; color: var(--accent-text); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            {series}
                        </h2>
                        
                        <!-- List of articles under this series -->
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                            {items.map((item) => (
                                <div class="card" style="display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem;">
                                    <div>
                                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                                            {formatDate(item.data.date)}
                                        </div>
                                        <h3 style="margin-top: 0; font-size: 1.2rem; margin-bottom: 0.5rem;">
                                            <a href={`/wiki/${item.id}`} style="color: var(--text); text-decoration: none;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text)'">
                                                {item.data.title}
                                            </a>
                                        </h3>
                                    </div>
                                    <p style="font-size: 0.85rem; line-height: 1.5; flex-grow: 1; margin-bottom: 0;">
                                        {item.body.slice(0, 140).replace(/\*\*|\*/g, '')}...
                                    </p>
                                    <div style="margin-top: 0.5rem;">
                                        <a href={`/wiki/${item.id}`} style="font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.85rem;">
                                            Read notes
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                        </a>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            )}
        </div>
    </div>
</Layout>
