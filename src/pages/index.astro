---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const pinnedPosts = await getCollection('blog', ({ data }) => data.pinned);
const recentUpdates = pinnedPosts
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 5);

const formatMonthYear = (date: Date) =>
    date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });

const summaryFor = (post: (typeof recentUpdates)[number]) =>
    post.data.summary ?? (post.body ?? '').slice(0, 160).replace(/\*\*|\*/g, '').trim() + '...';

// Cycled by position so entries stay visually distinct without needing a color per post
const dotColors = ['var(--accent-text)', 'var(--success-text)', 'var(--accent-text-purple)', 'var(--warning-text)', 'var(--accent-text-soft)'];
---

<Layout title="Home" description="Personal website and research portfolio of Fumiya Inaba, PhD Candidate in Interdisciplinary Oncology.">
    <!-- Hero Section -->
    <section class="hero-container" style="display: flex; gap: 3rem; align-items: center; margin-bottom: 4rem; flex-wrap: wrap;">
        <div class="hero-image-wrapper" style="flex: 1; min-width: 250px; display: flex; justify-content: center;">
            <div style="position: relative; width: 220px; height: 220px;">
                <!-- Glowing border behind the profile picture -->
                <div style="position: absolute; inset: -4px; background: var(--gradient); border-radius: 50%; filter: blur(8px); opacity: 0.7;"></div>
                <img 
                    src="/assets/fumi_face.jpg" 
                    alt="Fumiya Inaba" 
                    style="position: relative; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 3px solid var(--surface); background-color: var(--surface);"
                />
            </div>
        </div>
        
        <div class="hero-text" style="flex: 2; min-width: 300px;">
            <div style="display: inline-block; background-color: var(--tag-bg); color: var(--tag-text); padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem; border: 1px solid var(--tag-border);">
                PhD Candidate @ UBC / BC Cancer
            </div>
            <h1 style="margin-bottom: 0.5rem; font-size: 3rem;">
                Hi, I'm <span style="background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Fumiya Inaba</span>
            </h1>
            <p style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem; color: var(--text);">
                I am a computational researcher leveraging <strong>machine learning, computer vision, and digital pathology</strong> to translate complex medical images into actionable clinical insights.
            </p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="/assets/Fumiya_Inaba_CV.pdf" target="_blank" rel="noopener noreferrer" class="btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Download CV
                </a>
                <a href="https://github.com/fuminaba" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/></svg>
                    GitHub
                </a>
                <a href="https://linkedin.com/in/fumi-inaba" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                    LinkedIn
                </a>
                <a href="https://orcid.org/0009-0007-7848-573X" target="_blank" rel="noopener noreferrer me" class="btn btn-outline">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="7.5" y1="16" x2="7.5" y2="10"/><circle cx="7.5" cy="7" r="0.75" fill="currentColor" stroke="none"/><path d="M11 16v-6h1.75a3 3 0 1 1 0 6H11z"/></svg>
                    ORCID
                </a>
            </div>
        </div>
    </section>

    <!-- Research Pillars Section -->
    <section style="margin-bottom: 4rem;">
        <h2 style="margin-bottom: 0.5rem; text-align: center;">Research Scope</h2>
        <p style="text-align: center; max-width: 600px; margin: 0 auto 2.5rem auto; font-size: 0.95rem;">
            Currently pursuing research in the Interdisciplinary Oncology Program (IOP) at the BC Cancer Research Institute, focused on three core areas:
        </p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem;">
            <div class="card" style="display: flex; flex-direction: column;">
                <div style="width: 45px; height: 45px; border-radius: 10px; background: var(--tint-purple); border: 1px solid var(--tint-purple-border); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--accent-text-purple);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
                </div>
                <h3 style="margin-top: 0; margin-bottom: 0.75rem; font-size: 1.25rem;">Early Cancer Detection</h3>
                <p style="font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin-bottom: 0;">
                    Applying advanced image processing and computer vision algorithms to cytology and histology slide scans to detect malignancies at their earliest, most treatable stages.
                </p>
            </div>
            
            <div class="card" style="display: flex; flex-direction: column;">
                <div style="width: 45px; height: 45px; border-radius: 10px; background: var(--tint-indigo); border: 1px solid var(--tint-indigo-border); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--accent-text);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3 style="margin-top: 0; margin-bottom: 0.75rem; font-size: 1.25rem;">Reducing Overtreatment</h3>
                <p style="font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin-bottom: 0;">
                    Quantifying individual cell morphology and spatial architectures to distinguish indolent, non-threatening tumors from highly aggressive ones, avoiding unnecessary clinical interventions.
                </p>
            </div>
            
            <div class="card" style="display: flex; flex-direction: column;">
                <div style="width: 45px; height: 45px; border-radius: 10px; background: var(--tint-green); border: 1px solid var(--tint-green-border); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--success-text);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                </div>
                <h3 style="margin-top: 0; margin-bottom: 0.75rem; font-size: 1.25rem;">Prognostic Tools</h3>
                <p style="font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin-bottom: 0;">
                    Designing robust machine learning models like Multiple Instance Learning (MIL) to predict tumor recurrences and metastases directly from digital pathology slides.
                </p>
            </div>

            <div class="card" style="display: flex; flex-direction: column;">
                <div style="width: 45px; height: 45px; border-radius: 10px; background: var(--tint-amber); border: 1px solid var(--tint-amber-border); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--warning-text);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </div>
                <h3 style="margin-top: 0; margin-bottom: 0.75rem; font-size: 1.25rem;">Accelerated, Responsible Research</h3>
                <p style="font-size: 0.9rem; line-height: 1.6; flex-grow: 1; margin-bottom: 0;">
                    Developing solutions for more efficient and reproducible scientific research pipelines, utilizing modern AI tools to accelerate oncology and pathology workflows.
                </p>
            </div>
        </div>
        <div style="text-align: center; margin-top: 2rem;">
            <a href="/research" style="font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem;">
                Explore my research projects 
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
        </div>
    </section>

    <!-- Skills Grid Section -->
    <section style="margin-bottom: 4rem;">
        <h2 style="margin-bottom: 2rem;">Skillset Overview</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
            <!-- Category 1 -->
            <div style="background-color: var(--surface-subtle); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
                <h3 style="margin-top: 0; font-size: 1.15rem; color: var(--accent-text); border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    Machine Learning & AI
                </h3>
                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                    <span class="tag">Deep Learning</span>
                    <span class="tag">Multiple Instance Learning (MIL)</span>
                    <span class="tag">Graph Neural Networks</span>
                    <span class="tag">Point Clouds</span>
                    <span class="tag">Statistical Learning</span>
                    <span class="tag">Classifier Distillation</span>
                </div>
            </div>

            <!-- Category 2 -->
            <div style="background-color: var(--surface-subtle); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
                <h3 style="margin-top: 0; font-size: 1.15rem; color: var(--accent-text-soft); border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                    Digital Pathology & Image Processing
                </h3>
                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                    <span class="tag">Histology Image Analysis</span>
                    <span class="tag">Cytology Slide Scans</span>
                    <span class="tag">Computer Vision</span>
                    <span class="tag">Cell Morphometry</span>
                    <span class="tag">DNA Organization Analysis</span>
                    <span class="tag">Feature Extraction</span>
                </div>
            </div>

            <!-- Category 3 -->
            <div style="background-color: var(--surface-subtle); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
                <h3 style="margin-top: 0; font-size: 1.15rem; color: var(--accent-text-purple); border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Research Programming & Design
                </h3>
                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                    <span class="tag">Python</span>
                    <span class="tag">Experimental Design</span>
                    <span class="tag">Data Visualization</span>
                    <span class="tag">Scientific Communication</span>
                    <span class="tag">Git & Collaborations</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Updates / Activity Timeline -->
    <section>
        <h2 style="margin-bottom: 2rem;">Recent Updates</h2>
        
        {recentUpdates.length === 0 ? (
            <p>No updates yet. Check back soon!</p>
        ) : (
            <div style="position: relative; border-left: 2px solid var(--border); margin-left: 1rem; padding-left: 2rem; display: flex; flex-direction: column; gap: 2rem;">
                {recentUpdates.map((post, index) => (
                    <div style="position: relative;">
                        <div style={`position: absolute; left: -39px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: ${dotColors[index % dotColors.length]}; border: 3px solid var(--bg-color);`}></div>
                        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700; margin-bottom: 0.25rem;">{formatMonthYear(post.data.date)}</div>
                        <h3 style="margin-top: 0; font-size: 1.1rem; margin-bottom: 0.5rem;">
                            <a href={`/blog/${post.id}`} style="color: var(--text); text-decoration: none;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text)'">
                                {post.data.title}
                            </a>
                        </h3>
                        <p style="font-size: 0.9rem; margin-bottom: 0;">
                            {summaryFor(post)}
                        </p>
                    </div>
                ))}
            </div>
        )}
    </section>
</Layout>
