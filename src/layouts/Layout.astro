---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Fumiya Inaba - Personal Portfolio and Research Hub" } = Astro.props;

// Determine active page
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
    if (path === '/' && pathname === '/') return true;
    if (path !== '/' && pathname.startsWith(path)) return true;
    return false;
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Fumiya Inaba</title>
    <meta name="title" content={`${title} | Fumiya Inaba`} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Fumiya Inaba`} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} | Fumiya Inaba`} />
    <meta property="twitter:description" content={description} />

    <!-- Resolve the theme before first paint so there is no flash of the wrong colors -->
    <script is:inline>
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme'); } catch (e) { /* storage blocked */ }
            var theme = stored === 'light' || stored === 'dark'
                ? stored
                : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <header>
        <a href="/" class="logo-link" id="header-logo-link">
            <span class="logo-text">Fumiya Inaba</span>
        </a>
        <nav class="nav-links" aria-label="Main Navigation">
            <a href="/" class={isActive('/') ? 'active' : ''} id="nav-home">Home</a>
            <a href="/research" class={isActive('/research') ? 'active' : ''} id="nav-research">Research</a>
            <a href="/projects" class={isActive('/projects') ? 'active' : ''} id="nav-projects">Projects</a>
            <a href="/publications" class={isActive('/publications') ? 'active' : ''} id="nav-publications">Publications</a>
            <a href="/wiki" class={isActive('/wiki') ? 'active' : ''} id="nav-wiki">Wiki</a>
            <a href="/blog" class={isActive('/blog') ? 'active' : ''} id="nav-blog">Blog</a>
            <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch color theme">
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
            </button>
        </nav>
    </header>

    <main class="fade-in">
        <slot />
    </main>

    <footer>
        <div style="max-width: 1000px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                &copy; {new Date().getFullYear()} Fumiya Inaba. All rights reserved.
            </div>
            <div style="display: flex; gap: 1.5rem;">
                <a href="https://github.com/fuminaba" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted);" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">GitHub</a>
                <a href="https://linkedin.com/in/fumi-inaba" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted);" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">LinkedIn</a>
                <a href="/assets/Fumiya_Inaba_CV.pdf" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted);" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">CV (PDF)</a>
            </div>
        </div>
    </footer>

    <script is:inline>
        (function () {
            var root = document.documentElement;
            var toggle = document.getElementById('theme-toggle');
            var media = window.matchMedia('(prefers-color-scheme: light)');

            function describe(theme) {
                if (!toggle) return;
                toggle.setAttribute(
                    'aria-label',
                    theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
                );
            }

            describe(root.getAttribute('data-theme'));

            if (toggle) {
                toggle.addEventListener('click', function () {
                    var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                    root.setAttribute('data-theme', next);
                    describe(next);
                    try { localStorage.setItem('theme', next); } catch (e) { /* storage blocked */ }
                });
            }

            // Follow the OS only while the visitor hasn't picked a theme themselves
            media.addEventListener('change', function (event) {
                var stored = null;
                try { stored = localStorage.getItem('theme'); } catch (e) { /* storage blocked */ }
                if (stored === 'light' || stored === 'dark') return;
                var theme = event.matches ? 'light' : 'dark';
                root.setAttribute('data-theme', theme);
                describe(theme);
            });
        })();
    </script>
</body>
</html>
